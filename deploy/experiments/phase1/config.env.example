# Parameters of the phase 1 campaign. Copy this file to config.env (not versioned) and adapt the
# values.

# --- Machines -------------------------------------------------------------------
VM1_HOST=192.168.72.71      # legacy Moodle and k3s server node
VM2_HOST=192.168.72.72      # MySQL
VM3_HOST=192.168.72.73      # JMeter
SSH_USER=tesista

# Port the ssh daemon listens on (2222 in this environment).
SSH_PORT=2222

# Where this repository is cloned on VM1, and where reset-db.sh and config.env are on VM2.
SCRIPT_DIR_VM1=/home/tesista/repo-tesi/deploy/experiments/phase1
SCRIPT_DIR_VM2=/home/tesista/phase1

# --- Code trees on VM1 (the document root is a symbolic link to one of them) ---------
MOODLE_DOCROOT=/var/www/html/moodle
MOODLE_TREE_PRISTINE=/var/www/moodle-4.5-pristine
MOODLE_TREE_BRANCHED=/var/www/moodle-4.5-branched

# File included by both config.php, rewritten at every switch. See README.
MOODLE_OVERRIDES=/etc/moodle/phase1-overrides.php

# Services to restart after the switch: systemctl list-units --type=service | grep fpm
PHP_FPM_SERVICE=php8.3-fpm
WEB_SERVICE=apache2

# User the web server runs as: the caches are purged as this user.
WEB_USER=www-data

# --- Site address ---------------------------------------------------------------
# Equal to $CFG->wwwroot, path included; run-campaign.sh splits it into host, port and base path.
URL_DIRECT=http://192.168.72.71/moodle

# --- Database -------------------------------------------------------------------
DB_NAME=moodle_db

# Client command. With socket authentication no credential is needed; otherwise
# "mysql --defaults-extra-file=/root/.phase1-mysql.cnf".
MYSQL_CLIENT="sudo mysql"

# Table prefix, for the control count at every restore.
DB_PREFIX=mdl_

# Restore point, produced once before the campaign. See README.
DB_SNAPSHOT=/var/backups/moodle-phase1-baseline.sql.gz

# --- Load generator -------------------------------------------------------------
JMETER_BIN=/opt/apache-jmeter-5.6.3/bin/jmeter
JMX_PATH=/home/tesista/test_message.jmx
# The web service token, passed to the plan as the -Jwstoken property.
WS_TOKEN=CHANGEME

# Concurrency of the measured run, found with calibrate.sh.
MEASURE_THREADS=50

# Concurrency of the warm-up, whose results are discarded.
WARMUP_THREADS=25

# Web service token and range of recipient ids used by the plan. The real value goes in
# config.env.
WS_TOKEN=CHANGEME
RECIPIENT_ID_MIN=3
RECIPIENT_ID_MAX=10002

# --- Collection -----------------------------------------------------------------
RESULTS_DIR=./results
# Apdex thresholds in milliseconds (T and F of the JMeter report), equal to those of the
# baseline.
APDEX_T_MS=500
APDEX_F_MS=1500
