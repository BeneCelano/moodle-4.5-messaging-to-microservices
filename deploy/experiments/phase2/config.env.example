# Parameters of the phase 2 campaign. Copy this file to config.env (not versioned: it holds two
# tokens) and adapt the values.

# --- Machines -------------------------------------------------------------------
VM1_HOST=192.168.72.71      # legacy Moodle
VM2_HOST=192.168.72.72      # MySQL, both schemas
VM3_HOST=192.168.72.73      # JMeter
VM6_HOST=192.168.72.76      # k3s node hosting the ConversationService
SSH_USER=tesista
SSH_PORT=2222

# Where the scripts are on each machine. VM2 receives reset-db.sh and config.env only, with two
# scp.
SCRIPT_DIR_VM1=/home/tesista/repo-tesi/deploy/experiments/phase2
SCRIPT_DIR_VM2=/home/tesista/phase2

# --- The two targets ------------------------------------------------------------
MONOLITH_URL=http://192.168.72.71/moodle
SERVICE_URL=http://192.168.72.76:30081

# Moodle web service token and shared token of the service; the plans receive them as
# properties.
WS_TOKEN=CHANGEME
CS_API_TOKEN=CHANGEME

# User the web service token belongs to (the monolith sends on behalf of the token user). Found with:
#   SELECT u.id, u.username FROM mdl_external_tokens t JOIN mdl_user u ON u.id = t.userid
#    WHERE t.token = '<WS_TOKEN>';
SENDER_USER_ID=2

# --- Database -------------------------------------------------------------------
DB_NAME=moodle_db
DB_PREFIX=mdl_
CS_DB_NAME=conversation_service

MYSQL_CLIENT="sudo mysql"

# Restore points, produced once before the campaign, one per schema.
DB_SNAPSHOT=/var/backups/moodle-phase2-baseline.sql.gz
CS_DB_SNAPSHOT=/var/backups/conversation-phase2-baseline.sql.gz

# --- Load generator -------------------------------------------------------------
JMETER_BIN=/opt/apache-jmeter-5.6.3/bin/jmeter
JMX_DIR=/home/tesista/phase2-jmeter

# Range of the ids among which both plans pick the recipient, the same as in phase 1.
RECIPIENT_ID_MIN=3
RECIPIENT_ID_MAX=10002

# Same working point as phase 1.
MEASURE_THREADS=50
WARMUP_THREADS=25

# Loops per thread. The total of samples is MEASURE_THREADS * LOOPS, equal on both sides.
LOOPS=20
RAMPUP_SECONDS=10

# --- Collection -----------------------------------------------------------------
RESULTS_DIR=./results

# Apdex thresholds, identical to those of phase 1.
APDEX_T_MS=500
APDEX_F_MS=1500
