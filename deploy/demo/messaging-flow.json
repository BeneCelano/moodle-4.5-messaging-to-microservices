    {
      "type": "canvas",
      "title": "",
      "description": "Each block carries what it owns, and lights up while it is working. The monolith never lights: it exposes no metrics. Its ARROW does, fed by the requests the services answered, so what you see is not the monolith but the synchronous call leaving it. The DeliveryGateway has no inbound synchronous arrow, which is why the broker is its only way in. The two providers below the gateway are stand-ins outside the boundary: only the arrows reaching them light.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 17,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "instant": true,
          "legendFormat": "sincrono_c",
          "expr": "clamp_max(clamp_min(((sum(conversation_request_duration_seconds_count{service='conversation', route!~'.*(healthz|readyz|metrics).*'}) or vector(0)) - (sum(conversation_request_duration_seconds_count{service='conversation', route!~'.*(healthz|readyz|metrics).*'} offset 15s) or vector(0))), 0), 1)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "B",
          "instant": true,
          "legendFormat": "sincrono_n",
          "expr": "clamp_max(clamp_min(((sum(notification_request_duration_seconds_count{service='notification', route!~'.*(healthz|readyz|metrics).*'}) or vector(0)) - (sum(notification_request_duration_seconds_count{service='notification', route!~'.*(healthz|readyz|metrics).*'} offset 15s) or vector(0))), 0), 1)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "C",
          "instant": true,
          "legendFormat": "pubbl_c",
          "expr": "clamp_max(clamp_min(((sum(conversation_events_published_total{service='conversation'}) or vector(0)) - (sum(conversation_events_published_total{service='conversation'} offset 15s) or vector(0))), 0), 1)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "D",
          "instant": true,
          "legendFormat": "pubbl_n",
          "expr": "clamp_max(clamp_min(((sum(notification_events_published_total{service='notification'}) or vector(0)) - (sum(notification_events_published_total{service='notification'} offset 15s) or vector(0))), 0), 1)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "E",
          "instant": true,
          "legendFormat": "conversation",
          "expr": "clamp_max(clamp_min(((sum(conversation_messages_persisted_total{service='conversation'}) or vector(0)) - (sum(conversation_messages_persisted_total{service='conversation'} offset 15s) or vector(0))) + ((sum(conversation_events_published_total{service='conversation'}) or vector(0)) - (sum(conversation_events_published_total{service='conversation'} offset 15s) or vector(0))), 0), 1)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "F",
          "instant": true,
          "legendFormat": "notification",
          "expr": "clamp_max(clamp_min(((sum(notification_notifications_persisted_total{service='notification'}) or vector(0)) - (sum(notification_notifications_persisted_total{service='notification'} offset 15s) or vector(0))) + ((sum(notification_events_published_total{service='notification'}) or vector(0)) - (sum(notification_events_published_total{service='notification'} offset 15s) or vector(0))) + ((sum(notification_events_consumed_total{service='notification'}) or vector(0)) - (sum(notification_events_consumed_total{service='notification'} offset 15s) or vector(0))), 0), 1)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "G",
          "instant": true,
          "legendFormat": "delivery",
          "expr": "clamp_max(clamp_min(((sum(delivery_gateway_deliveries{service='delivery',status='delivered'}) or vector(0)) - (sum(delivery_gateway_deliveries{service='delivery',status='delivered'} offset 15s) or vector(0))), 0), 1)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "H",
          "instant": true,
          "legendFormat": "broker",
          "expr": "clamp_max(clamp_min(((sum(conversation_events_published_total{service='conversation'}) or vector(0)) - (sum(conversation_events_published_total{service='conversation'} offset 15s) or vector(0))) + ((sum(notification_events_published_total{service='notification'}) or vector(0)) - (sum(notification_events_published_total{service='notification'} offset 15s) or vector(0))), 0), 1)"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "outer"
          }
        }
