    {
      "type": "stat",
      "title": "Message or notification stored",
      "description": "A message written by the ConversationService, or a notification written by the NotificationService. This is the only step served synchronously, and the only one the user waits for.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
