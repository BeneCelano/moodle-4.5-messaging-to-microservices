# Development environment of the NotificationService. Copy this file to .env (not tracked) and
# fill it in; on the cluster the values come from the ConfigMap and the Secret.

NS_SERVICE_NAME=notification-service
NS_ENVIRONMENT=dev
NS_LOG_LEVEL=DEBUG

NS_DATABASE_URL=mysql+aiomysql://notification_svc:CHANGEME@127.0.0.1:3306/notification_service

NS_RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
NS_RABBITMQ_EXCHANGE=moodle.messaging

# Publishing side.
NS_PUBLISHER_ENABLED=true

# Consuming side; switch it off when working on the routes without a broker.
NS_CONSUMER_ENABLED=true
NS_RABBITMQ_QUEUE=notification-service.events
NS_RABBITMQ_ROUTING_KEYS=conversation.contactrequest.created

# Public address of the site, used in the links of the composed notifications; equal to
# $CFG->wwwroot.
NS_SITE_WWWROOT=http://localhost

# Empty in development: the check is not performed.
NS_API_TOKEN=
