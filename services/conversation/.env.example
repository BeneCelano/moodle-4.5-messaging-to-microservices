# Copy this file to .env and adapt the values to the environment.
# On the cluster the values come from the ConfigMap and the Secret, not from this file.

# --- Identity of the service ------------------------------------------------
CS_SERVICE_NAME=conversation-service
CS_ENVIRONMENT=lab
CS_LOG_LEVEL=INFO

# --- Persistence (VM2, dedicated schema with a dedicated user) --------------
CS_DATABASE_URL=mysql+aiomysql://conversation_svc:CHANGEME@192.168.72.72:3306/conversation_service
CS_DB_POOL_SIZE=10
CS_DB_MAX_OVERFLOW=10
CS_DB_POOL_TIMEOUT=5

# --- Broker (RabbitMQ in the messaging namespace of the k3s cluster) --------
CS_RABBITMQ_URL=amqp://messaging:CHANGEME@rabbitmq.messaging.svc.cluster.local:5672/
CS_RABBITMQ_EXCHANGE=moodle.messaging
CS_OUTBOX_POLL_INTERVAL_SECONDS=0.5
CS_OUTBOX_BATCH_SIZE=100

# --- Authentication of incoming calls ---------------------------------------
# Token shared with the monolith (header Authorization: Bearer ...).
CS_API_TOKEN=CHANGEME
